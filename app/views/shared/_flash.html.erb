<% if flash && (flash[:notice] || flash[:info] || flash[:warn] || flash[:error]) %>
<div class="row-fluid">
	<div class="span12">
	<% if flash[:notice] %>
	<div class="alert alert-info">
		<a class="close" data-dismiss="alert" href="#">&times;</a>
		<%= flash[:notice] %>
	</div>
	<% end %>
</div>
</div>
<% end %>