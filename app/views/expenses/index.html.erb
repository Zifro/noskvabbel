<h2><%= t('.list') %></h2>
<br />

<%= link_to t('.record_new_expense'), new_expense_path %>

<table id="expenses" class="table">
	<tr>
		<th><%= t('.when') %></th>
		<th><%= t('.what') %></th>
		<th><%= t('.how_much') %></th>
		<th><%= t('.who') %></th>
		<th><%= t('.actions') %></th>
	</tr>
	<tr class="balance" id="balance_user_1">
		<%= render partial: 'balance_user_1' %>
	</tr>
	<tr class="balance user_2" id="balance_user_2">
		<%= render partial: 'balance_user_2' %>
	</tr>
	<tbody id="expenses_rows">
		<%= render partial: 'expense_rows', locals: { expenses: @expenses } %>
	</tbody>
</table>

<%= render partial: 'load_more_buttons' %>

<% if @expenses.empty? && @all_expenses_loaded %>
	<%= t('.none_yet') %>
	<%= link_to t('.new_one'), new_expense_path %> ?
<% end %>
